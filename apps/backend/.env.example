NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Origins allowed by CORS, comma separated
CORS_ORIGIN=http://localhost:3000

# Who may report the real client IP (the panel, which forwards the visitor IP on
# login when it sits behind a trusted reverse proxy)
TRUST_PROXY=loopback

# SQLite database (path relative to this folder)
DB_DATABASE=database.sqlite

# Secret that signs the access token, at least 32 characters. The API refuses this
# sample value in production. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-this-development-secret-to-a-random-one

# Access token lifetime in minutes (1 to 1440)
JWT_ACCESS_TTL_MINUTES=15

# Refresh token lifetime in days (1 to 90)
REFRESH_TOKEN_TTL_DAYS=7

# bcrypt cost factor of the password hashes (4 to 15)
BCRYPT_ROUNDS=10
